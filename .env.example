# Public Sanity project and dataset used by the website and embedded Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-04

# Explicit environment: development, staging, or production. Only production is indexable.
NEXT_PUBLIC_SITE_ENV=development
# Canonical origin only, for example https://example.org (required for release builds).
NEXT_PUBLIC_SITE_URL=

# Local/CI fixtures only. Never enable on Vercel/Netlify or a real deployment.
SANITY_TEST_MODE=false

# Server-only secret shared with the Sanity webhook. Never prefix with NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=
