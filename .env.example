# Public Sanity project and dataset used by the website and embedded Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-04

# Canonical site origin, for example https://example.org
NEXT_PUBLIC_SITE_URL=

# Server-only secret shared with the Sanity webhook. Never prefix with NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=
